  </div>
  <div style="display: flex; justify-content: flex-end; margin-top: 15px; gap: 15px; opacity: 0.8;">
    <span><i class="fas fa-hd"></i>  1080p · 4K ready</span>
    <span><i class="fas fa-closed-captioning"></i> Legendas inclusas</span>
  </div>
</section>

<footer>
  <div>© 2026 Super Tela Streaming — Alta definição, design premium e imersão total.</div>
  <div class="social-links">
    <i class="fab fa-instagram"></i>
    <i class="fab fa-twitter"></i>
    <i class="fab fa-youtube"></i>
    <i class="fab fa-tiktok"></i>
  </div>
  <div style="margin-top: 12px; font-size: 0.7rem;">Interface profissional · Todos os direitos reservados</div>
</footer>

<script>
  // Interações e smooth scroll + modais (apenas melhoria UX)
  document.querySelectorAll('nav a').forEach(anchor => {
    anchor.addEventListener('click', function(e) {
      const hash = this.getAttribute('href');
      if (hash && hash !== "#") {
        const targetId = hash.substring(1);
        const targetElement = document.getElementById(targetId);
        if (targetElement) {
          e.preventDefault();
          targetElement.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }
    });
  });

  const heroBtn = document.getElementById('heroBtn');
  if(heroBtn) {
    heroBtn.addEventListener('click', () => {
      const filmesSection = document.getElementById('filmes');
      if(filmesSection) filmesSection.scrollIntoView({ behavior: 'smooth' });
    });
  }

  const seriesBtn = document.getElementById('seriesBtn');
  if(seriesBtn) {
    seriesBtn.addEventListener('click', () => {
      alert("🎬 Trailer de REINO DIGITAL em breve nos cinemas digitais! Acesse nosso catálogo completo.");
    });
  }

  // pequeno tooltip em cards (efeito futurista)
  const cards = document.querySelectorAll('.movie-card');
  cards.forEach(card => {
    card.addEventListener('click', () => {
      console.log('filme em destaque');
      // poderia abrir modal, mas mantemos elegante
    });
  });
</script>
</body>
